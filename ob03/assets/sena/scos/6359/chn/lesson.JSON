"type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "consider", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "It's really important that you", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "considerate", "type": "text"}]}, {"type": "post_question", "contents": {"content": "that offer. Make sure you don't make the wrong decision. ", "type": ""}}, {"content": "secondary_7", "type": "objective"}], "id": 1}, {"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "think", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "We must", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "risk", "type": "text"}]}, {"type": "post_question", "contents": {"content": "twice about that statement. What if it is wrong and we've been making all our decision based on it. ", "type": ""}}, {"content": "secondary_7", "type": "objective"}], "id": 2}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " Let's make sure we make the right decisions.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: \n<span class=\"bullet\">Proofread the sentences.</span> \n<span class=\"bullet\">Click on the incorrect word.</span> \n<span class=\"bullet\">Type in the correct word to complete the sentences.\n", "type": "text"}]}], "type": "GIW", "id": 9}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "however", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "moreover", "type": "text"}], "id": 1, "text": ""}, {"correct": 0, "selected": 0, "_data": [{"content": "therefore", "type": "text"}], "id": 2, "text": ""}], "_data": [{"type": "question", "contents": [{"content": "I know you are a very impulsive person,", "type": "text"}]}, {"type": "post_question", "contents": {"content": ", you should think things through more often.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 0}, {"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "despite the fact", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "in fact", "type": "text"}], "id": 1, "text": ""}, {"correct": 0, "selected": 0, "_data": [{"content": "however", "type": "text"}], "id": 2, "text": ""}], "_data": [{"type": "question", "contents": [{"content": "You know I like to bounce ideas off with you,", "type": "text"}]}, {"type": "post_question", "contents": {"content": ", I would prefer not to do so with anyone else. ", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 1}, {"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "Moreover", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "There fore", "type": "text"}], "id": 1, "text": ""}, {"correct": 1, "selected": 0, "_data": [{"content": "Even so", "type": "text"}], "id": 2, "text": ""}], "_data": [{"type": "question", "contents": [{"content": "I know you don't like going to school.", "type": "text"}]}, {"type": "post_question", "contents": {"content": ", you should attend everyday. ", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 2}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " \nHow to organize my speech.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Move the words from the box to correctly complete the sentences.\n", "type": "text"}]}], "id": 10, "type": "MF1"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "id": 11}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le18ob03re2img01.jpg", "audiosrc": "engenn8le18ob03re2aud01", "images": [{"time": "0", "image": "engenn8le18ob03re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le18ob03re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Sally, going back to school is a big decision for you to make. You really need to take some time to determine what's best for you. Don't jump the gun.\n<br/><span class=\"strong\">Sally</span>: Oh I know! I definitely need to evaluate the benefits and the costs of going back to school.\n<br/><span class=\"strong\">Vanessa</span>: You might be being a little impulsive, so let's think this over together.\n<br/><span class=\"strong\">Sally</span>: Okay. Thanks Vanessa! It could help to have someone to bounce ideas off of."}, {"time": "22900", "image": "engenn8le18ob03re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: You already have a great job as a writer. You're not supposed to give up a good career.\n<br/><span class=\"strong\">Sally</span>: On the other hand, sometimes change is good.\n<br/><span class=\"strong\">Vanessa</span>: That's true. However, it might be best to stick with what you're good at.\n<br/><span class=\"strong\">Sally</span>: Yeah, maybe. Even so, doing the same thing all the time can get stale. Doing something different could breathe life into my work."}, {"time": "43500", "image": "engenn8le18ob03re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: That's true. All the same, you could start studying something new and discover that you really don't like it. You might waste a lot of time and money. On top of that, studying might take up so much of your time that you can't see your friends.\n<br/><span class=\"strong\">Sally</span>: Vanessa! You are supposed to be more supportive! Why are you being so disagreeable?\n<br/><span class=\"strong\">Vanessa</span>: Don't worry Sally. I'm just playing the devil's advocate. You know I'll support any decision you make. Finish up your coffee. Let's go for a stroll."}]}}], "id": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Big Decisions", "type": "lesson_name"}, {"content": "Thinking It Over", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about backgrounds in a wider variety of communicative situations.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le18ob03re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Organizing Points in an Argument", "type": "heading"}, {"content": "You use words or phrases to organize ideas in a piece of writing. <br/>Discourse markers show how ideas are connected. They usually come at the beginning of a sentence.", "type": "describer"}, {"content": "Discourse markers can show a <span class=\"strong\">connection </span>to what the writer is saying and what was just written. They can also show what the writer's <span class=\"strong\">opinion </span>is about what is being discussed. ", "type": "text"}, {"content": "{\"rows\":12,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Discourse Marker\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">All the same</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Despite what has been said\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Even so</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Despite what has been said\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">On top of that</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adding\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">On the other hand</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Contrasting two arguments\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "On the other hand, sometimes change is good. ", "type": "example"}, {"content": "Even so, doing the same thing all the time can get stale.", "type": "example"}, {"content": "That's true. All the same, you could start studying something new.", "type": "example"}, {"content": "On top of that, studying might take up so much of your time that you can't see your friends.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Modal Verbs for Speculating  ", "type": "heading"}, {"content": "When you speculate about something, you are making a guess based on what you know about the situation.", "type": "describer"}, {"content": "You can show you are speculating about something by using a modal, like <span class=\"italic\">must</span>, <span class=\"italic\">might</span>, <span class=\"italic\">may </span>or <span class=\"italic\">could</span>.", "type": "text"}, {"content": "The modal verb is followed by the main verb in the base form. You do not use \u201c<span class=\"italic\">to</span>\u201d. Do not add \u201c<span class=\"italic\">ing</span>\u201d, \u201c<span class=\"italic\">ed</span>\u201d, or \u201c<span class=\"italic\">s</span>\u201d to the verb.", "type": "text"}, {"content": "Example:<br/><span class=\"italic\">I think you <span class=\"strong\">may be able to help</span> me.</span>", "type": "text"}, {"content": "These are formal structures.", "type": "text"}, {"content": "You might be being a little impulsive, so let's think this over together.", "type": "example"}, {"content": " It could help to have someone to bounce ideas off of.", "type": "example"}, {"content": " However, it might be best to stick with what you're good at.", "type": "example"}, {"content": "Doing something different could breathe life into my work.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to determine", "type": "name"}, {"content": "to make a decision about what is best", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You really need to take some time to determine what's best for you. ", "type": "example"}, {"content": "engenn8le18ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about decision-making.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "impulsive ", "type": "name"}, {"content": "inclined to act without thinking about the consequences", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You might be being a little impulsive, so let's think this over together.", "type": "example"}, {"content": "engenn8le18ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to bounce ideas off ", "type": "name"}, {"content": "to discuss an idea with someone in order to get another perspective ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: It could help to have someone to bounce ideas off of.", "type": "example"}, {"content": "engenn8le18ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "stale ", "type": "name"}, {"content": "boring and no longer interesting", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Doing the same thing all the time can get stale.", "type": "example"}, {"content": "engenn8le18ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "supportive ", "type": "name"}, {"content": "helpful and encouraging, usually during a difficult situation", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You are supposed to be more supportive! Why are you being so disagreeable?", "type": "example"}, {"content": "engenn8le18ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to breathe life into something", "type": "name"}, {"content": "to improve something with new ideas and energy", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Doing something different could breathe life into my work. ", "type": "example"}, {"content": "engenn8le18ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "stroll ", "type": "name"}, {"content": "a slow, pleasurable walk", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Finish up your coffee. Let's go for a stroll.", "type": "example"}, {"content": "engenn8le18ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to jump the gun", "type": "name"}, {"content": "to say or do something too soon without giving it enough thought", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You really need to take some time to determine what's best for you. Don't jump the gun.", "type": "example"}, {"content": "engenn8le18ob03aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "On the internet, research the term \u201cthe devil's advocate.\u201d", "type": "text"}, {"content": "Make notes about the history of this term, where it was first used and how we use it today.", "type": "text"}, {"content": "Look for any other expressions that have the same meaning, either in English or in your language.", "type": "text"}, {"content": "Present the information that you found to your class or a group.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about decision-making.", "type": "text"}, {"content": "I speculate about things, people and events.", "type": "text"}, {"content": "I research and make notes.", "type": "text"}, {"content": "I present information to a group.", "type": "text"}]}], "type": "sena"}