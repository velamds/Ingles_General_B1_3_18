content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "a risk", "type": "text"}], "selected": 0}, {"id": 1, "text": "", "correct": 1, "_data": [{"content": "an option", "type": "text"}], "selected": 0}, {"id": 2, "text": "", "correct": 0, "_data": [{"content": "a considering", "type": "text"}], "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "I won't leave my country, that's not even", "type": "text"}]}, {"type": "post_question", "contents": {"content": ".", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"type": "audio", "_data": [], "title": "", "template_override": 1, "id": 1, "contents": [{"value": {"images": [{"text": "", "image": "engenn8le18ob02re2img01.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Vanessa</span>: So ... I'm dying to know. What is this decision you have to make?\n<br/><span class=\"strong\">Sally</span>: I think I want to go back to school.\n<br/><span class=\"strong\">Vanessa</span>: Really? Why?\n<br/><span class=\"strong\">Sally</span>: I've been blogging for a while and I feel like I'm ready for a fresh start.\n<br/><span class=\"strong\">Vanessa</span>: Hmm ... okay. Let's talk about the pros and cons.", "image": "engenn8le18ob02re2img01.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Sally</span>: Well, first, you know I love blogging but it could be exciting to do something new and different.\n<br/><span class=\"strong\">Vanessa</span>: Yeah, you must be getting a bit tired of blogging.\n<br/><span class=\"strong\">Sally</span>: Yeah, a bit. I'd like to try something new. What's more, I might enjoy doing something that doesn't involve working on a computer. I could do something a little more active.\n<br/><span class=\"strong\">Vanessa</span>: I understand. It must be hard to work at a computer all day long. But do you really need to go back to school?", "image": "engenn8le18ob02re2img02.jpg", "time": "16500", "id": 2}, {"text": "<span class=\"strong\">Sally</span>: Well, my second point is that I really love learning. It might be fun to learn about something new. And I may meet some interesting people.\n<br/><span class=\"strong\">Vanessa</span>:  Okay. That's true. But it's so costly to go to school.\n<br/><span class=\"strong\">Sally</span>: I know. That's the part that I need to come to terms with. I do still have some money left from the lottery winnings.\n<br/><span class=\"strong\">Vanessa</span>: Are you sure that going to school is the best way to spend it?\n<br/><span class=\"strong\">Sally</span>: No, I'm not sure! That's my dilemma! But it would be an investment in my future.\n<br/><span class=\"strong\">Vanessa</span>: It's definitely something to think over.", "image": "engenn8le18ob02re2img05.jpg", "time": "41800", "id": 3}], "coverimg": "engenn8le18ob02re2img01.jpg", "audiosrc": "engenn8le18ob02re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Big Decisions", "type": "lesson_name"}, {"content": "Weighing the Pros and Cons", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about backgrounds in a wider variety of communicative situations.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Organizing Points in an Argument", "type": "heading"}, {"content": "You use words or phrases to organize ideas in a piece of writing. <br/>Discourse markers show how ideas are connected. They usually come at the beginning of a sentence.", "type": "describer"}, {"content": "Discourse markers can show a <span class=\"strong\">connection </span>to what the writer is saying and what was just written. They can also show what the writer's <span class=\"strong\">opinion </span>is about what is being discussed. ", "type": "text"}, {"content": "Look at the chart for some common discourse markers and their meanings:", "type": "text"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Discourse Marker\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">However</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">But</span>; Contrast\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Therefore</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Logical consequence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">In spite of</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Emphasizing a contrast\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">What is more</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adding\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Of course</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Stating it is obvious\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">In fact</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Emphasizing and adding\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "In spite of the violence (or maybe because of it), young kids love cartoons and prefer watching them to anything else.", "type": "example"}, {"content": "What is more, it is known that young children in the U.S. watch between 25 and 52 hours of television per week.", "type": "example"}, {"content": "Therefore, we might be bringing up an extremely violent younger generation! ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Modal Verbs for Speculating  ", "type": "heading"}, {"content": "We can use these modal verbs (also called modals of deduction, speculation or certainty) when we want to make a guess about something. We choose the verb depending on how sure we are.", "type": "describer"}, {"content": "You can show you are speculating about something by using a modal, like <span class=\"italic\">must</span>, <span class=\"italic\">might</span>, <span class=\"italic\">may </span>or <span class=\"italic\">could</span>.", "type": "text"}, {"content": "The modal verb is followed by the main verb in the base form. You do not use \u201c<span class=\"italic\">to</span>\u201d. Do not add \u201c<span class=\"italic\">ing</span>\u201d, \u201c<span class=\"italic\">ed</span>\u201d, or \u201c<span class=\"italic\">s</span>\u201d to the verb.", "type": "text"}, {"content": "These are formal structures.", "type": "text"}, {"content": " Yeah, you must be getting a bit tired of blogging.", "type": "example"}, {"content": "What's more, I might enjoy doing something that doesn't involve working on a computer. ", "type": "example"}, {"content": "It might be fun to learn about something new. ", "type": "example"}, {"content": "And I may meet some interesting people.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to be dying to do something", "type": "name"}, {"content": "to be eager to do something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm dying to know. What is this decision you have to make?", "type": "example"}, {"content": "engenn8le18ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about social activities and decision-making. ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "fresh start", "type": "name"}, {"content": "a new opportunity to start something again", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm starting school next month, I feel like I'm ready for a fresh start.", "type": "example"}, {"content": "engenn8le18ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "costly ", "type": "name"}, {"content": "something that has a high price", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I know it might be fun to learn something new, but it's so costly to go to school. ", "type": "example"}, {"content": "engenn8le18ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to come to terms with", "type": "name"}, {"content": "to accept the outcome of a situation or an argument", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: There are many pros and cons of going back to school, so need to come to terms with.", "type": "example"}, {"content": "engenn8le18ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "dilemma ", "type": "name"}, {"content": "a difficult or problematic situation in which a decision needs to be taken", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm not sure if going to school is the best way to spend my money, that's my dilemma! ", "type": "example"}, {"content": "engenn8le18ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to think over", "type": "name"}, {"content": "to consider a situation carefully ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Going back to school would mean spending a lot of money, but it's also an investment in my future. It's definitely something to think over. ", "type": "example"}, {"content": "engenn8le18ob02aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "On the internet, research some different schools and programs that you might want to go to.", "type": "text"}, {"content": "Put the schools and programs in a list and order them from most interesting to least interesting. ", "type": "text"}, {"content": "Be prepared to explain your choices.", "type": "text"}, {"content": "Share your list with a partner. Do they have any programs that you want to add to your list?", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about social activities and decision-making.", "type": "text"}, {"content": "I organize points in an argument.", "type": "text"}, {"content": "I speculate about things, people and events.", "type": "text"}, {"content": "I research schools and programs on the internet.", "type": "text"}]}, {"content": "engenn8le18ob02re1img01.jpg", "type": "background_image"}]}