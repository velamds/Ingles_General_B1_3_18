tent": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 3}, {"_data": [{"type": "question", "contents": [{"content": "More families may be brought into the restaurant with this change.", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "engenn8le18ob10re4aud03", "type": "text"}], "id": 1}], "id": 4}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 5}, {"_data": [{"type": "question", "contents": [{"content": "Take more time to consider the negative consequences that could be caused by this change .", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "engenn8le18ob10re4aud04", "type": "text"}], "id": 1}], "id": 6}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 7}, {"_data": [{"type": "question", "contents": [{"content": "Your idea had better be appreciated by the owner. ", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "engenn8le18ob10re4aud05", "type": "text"}], "id": 1}], "id": 8}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 9}], "_data": [{"type": "instructions", "contents": [{"content": " Is Vanessa's idea good?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"correct_feedback": "You are done!", "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio. </span> <span class=\"bullet\">Record yourself saying the sentences aloud.</span>  <span class=\"bullet\">Compare yourself to the audio.</span>\n", "type": "text"}]}], "stimuli_ids": [], "template_override": 1, "id": 10, "type": "SR1"}, {"questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "id": 11}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le18ob10re2img05.jpg", "audiosrc": "engenn8le18ob10re2aud01", "images": [{"time": "0", "image": "engenn8le18ob10re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le18ob10re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Hello?\n<br/><span class=\"strong\">Sally</span>: Hi Vanessa. Listen, I've been thinking about your plan and I'm really uneasy about it. I don't want you to make a rash decision.\n<br/><span class=\"strong\">Vanessa</span>: I know you must be startled by my sudden decision but you ought to hear me out. To begin with, I have given this a lot of thought. I've done some research into local restaurant trends.\n<br/><span class=\"strong\">Sally</span>: You seem confident that more families will be brought to the restaurant by this change but have you thought about the adverse consequences?"}, {"time": "25500", "image": "engenn8le18ob10re2img06.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: You must tell me your concerns.\n<br/><span class=\"strong\">Sally</span>: Well, it's true that this change may bring in more families but think about the customers that don't have kids. More alcoholic drinks and food may be ordered by diners that don't have children with them. I think that people who eat out without children tend to spend more money.\n<br/><span class=\"strong\">Vanessa</span>: You have a point. I had better take some more time to consider the negative consequences that could be caused by this change. You have got to think I'm crazy!"}, {"time": "51500", "image": "engenn8le18ob10re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: No, I think you are ambitious and creative and you had better be appreciated by the owner.\n<br/><span class=\"strong\">Vanessa</span>: Actually, I haven't discussed my idea with the owner yet. I'll present my concept tomorrow. He might be taken aback! Wish me luck!\n<br/><span class=\"strong\">Sally</span>: You must be eager to share your idea! Good luck tomorrow! Let's meet after you talk to the owner and grab a bite."}]}}], "id": 1}]}], "_data": [{"type": "metadata", "contents": [{"content": "Big Decisions", "type": "lesson_name"}, {"content": "New Beginnings", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about backgrounds in a wider variety of communicative situations.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le18ob10re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Modals for Possibility and Necessity", "type": "heading"}, {"content": "You use modals when you want to express possibility and necessity.", "type": "describer"}, {"content": "<span class=\"strong\">You use <span class=\"italic\">may</span>, <span class=\"italic\">might</span> and <span class=\"italic\">could</span> to express possibility in the past and in the future.</span>", "type": "text"}, {"content": "*<span class=\"italic\">Might </span>suggests that something is less possible than <span class=\"italic\">may</span>.", "type": "text"}, {"content": "<ul><li><span class=\"italic\">might </span>/ <span class=\"italic\">might not</span> + infinitive</li><li><span class=\"italic\">could </span>/ <span class=\"italic\">could not</span> + infinitive</li><li><span class=\"italic\">may </span>/ <span class=\"italic\">may not</span> + infinitive</li><li><span class=\"italic\">ought to</span> (we do not use <span class=\"italic\">ought to</span> in the negative)</li></ul>", "type": "text"}, {"content": "<span class=\"strong\">Expressing Necessity</span>", "type": "text"}, {"content": "You use <span class=\"italic\">must </span>or <span class=\"italic\">have to</span> and <span class=\"italic\">had better</span> to express that something is necessarily true. ", "type": "text"}, {"content": "Example:<br/><span class=\"italic\">You must tell me your concerns.</span>", "type": "text"}, {"content": "You really ought to hear me out. ", "type": "example"}, {"content": "You must tell me your concerns.", "type": "example"}, {"content": "I had better take some more time to consider the negative consequences.", "type": "example"}, {"content": "Negative consequences could be caused by this change.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Modal Verbs in the Passive Voice", "type": "heading"}, {"content": "You use modal verbs to add meaning to other verbs. They come before the dictionary form (infinitive without \u2018<span class=\"italic\">to</span>') of the main verb.<br/>Modal verbs can add meaning connected with certainty or obligation.", "type": "describer"}, {"content": "You can use modal verbs in the passive voice.  <br/>You use the passive voice when you want to focus on the receiver of the action, rather than the \u2018doer' of the action.", "type": "text"}, {"content": "Here is the structure of a passive sentence:", "type": "text"}, {"content": "Subject + to be + past participle", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">More money <span class=\"strong\">is spent</span> by people who don't have children.</span>", "type": "text"}, {"content": "You can add a modal verb before the <span class=\"italic\">To be</span>.", "type": "text"}, {"content": "Subject + modal + to be + past participle", "type": "text"}, {"content": "Example: <br/><span class=\"italic\">More money <span class=\"strong\">may be spent</span> by people who don't have children.</span>", "type": "text"}, {"content": "Here the sentence now has an additional meaning of possibility, thanks to the modal <span class=\"italic\">may</span>.", "type": "text"}, {"content": "I know you must be startled by my sudden decision.", "type": "example"}, {"content": "More families may be brought to the restaurant by this change.", "type": "example"}, {"content": "More alcoholic drinks and food may be ordered by diners that don't have children with them.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "uneasy ", "type": "name"}, {"content": "to feel worried or uncomfortable about something", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I've been thinking about your plan and I'm really uneasy about it. I don't want you to make a rash decision.", "type": "example"}, {"content": "engenn8le18ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about feelings and reactions.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "startled ", "type": "name"}, {"content": "to be alarmed and surprised by something", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I know you must be startled by my sudden decision but you ought to hear what I have to say.", "type": "example"}, {"content": "engenn8le18ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to hear someone out", "type": "name"}, {"content": "to listen to everything someone has to say", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I know you must be startled by my sudden decision but you ought to hear me out.", "type": "example"}, {"content": "engenn8le18ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "adverse ", "type": "name"}, {"content": "something that is in opposition to one's interest", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You seem confident that more families may be brought to the restaurant by this change but have you thought about the adverse consequences?", "type": "example"}, {"content": "engenn8le18ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to tend to", "type": "name"}, {"content": "to be inclined toward an idea", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I think that people who eat out without children tend to spend more money.", "type": "example"}, {"content": "engenn8le18ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to have a point", "type": "name"}, {"content": "to have a valid and logical argument", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You have a point. I had better take some more time to consider the negative consequences that could be caused by this change.", "type": "example"}, {"content": "engenn8le18ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "concept ", "type": "name"}, {"content": "a structured and previously thought of idea", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Actually, I haven't discussed my idea with the owner yet. I'll present my concept tomorrow. ", "type": "example"}, {"content": "engenn8le18ob10aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "taken aback", "type": "name"}, {"content": "feeling surprised and confused about something", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'll present my concept tomorrow. He might be taken aback! Wish me luck!", "type": "example"}, {"content": "engenn8le18ob10aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "eager ", "type": "name"}, {"content": "showing an intense desire to do something", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You must be eager to share your idea! Good luck tomorrow!", "type": "example"}, {"content": "engenn8le18ob10aud09", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about feelings and reactions.", "type": "text"}, {"content": "I speculate about things. ", "type": "text"}, {"content": "I express possibility and necessity.", "type": "text"}, {"content": "I research on the internet and present information to a group.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "On the internet, research major historical decisions (Google search \u201chistorical decisions that changed the world\u201d). ", "type": "text"}, {"content": "Choose one decision and research it thoroughly.", "type": "text"}, {"content": "Make detailed notes on the decision. Be sure to include how the decision was made and if the decision-maker had help from anyone.", "type": "text"}, {"content": "Present your information to your class or group.", "type": "text"}]}], "type": "sena"}